{
  "name": "codexmate",
  "version": "1.1.0-rc.1",
  "description": "Local-first GitHub collaboration for independent Codex accounts",
  "license": "MIT",
  "type": "module",
  "bin": { "codexmate": "dist/cli/index.js" },
  "files": ["dist", "web-dist", "templates", "docs", "README.md"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx src/cli/index.ts ui",
    "start": "node dist/cli/index.js ui",
    "demo": "tsx src/cli/index.ts demo",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/codex-sdk": "latest",
    "@phosphor-icons/react": "^2.1.10",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
