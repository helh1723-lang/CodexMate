{
  "name": "codexmate",
  "version": "2.0.0-alpha.2",
  "description": "Minimal two-agent collaboration chat for independent Codex accounts",
  "main": "dist/desktop/main.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codexmate": "dist/chat/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "templates",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/chat/cli.ts ui",
    "start": "node dist/chat/cli.js ui",
    "desktop": "electron .",
    "relay": "tsx src/chat/cli.ts relay",
    "cli": "tsx src/chat/cli.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "verify:context": "node scripts/verify-context.mjs",
    "shots:ui": "node scripts/screenshot-ui.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "build": {
    "appId": "dev.codexmate.chat",
    "productName": "CodexMate",
    "directories": {
      "output": "artifacts/desktop"
    },
    "files": [
      "dist/**/*",
      "web-dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  },
  "dependencies": {
    "@openai/codex-sdk": "0.156.1",
    "@phosphor-icons/react": "^2.1.10",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
